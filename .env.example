# Supabase Postgres via the transaction-mode pooler (port 6543). The app uses prepare: false.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: drizzle-kit only. Session pooler (same host, port 5432). Falls back to DATABASE_URL.
# DATABASE_MIGRATE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Better Auth: a long random string, and the public origin of the web app.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Solana mainnet RPC for the analytics page's on-chain bin and fee reads; without it the public endpoint is used.
# Auto-rebalance does not use it: each user saves their own RPC URL with their agent wallet.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=<your-helius-key>"

# Optional: Solana Tracker Data API key (free plan at solanatracker.io). Powers the whale, smart money and KOL lists on /analytics (at most 80 requests a day).
# SOLANA_TRACKER_API_KEY=

# apps/agents (volume spike and auto-rebalance runner). Telegram alerts go through each user's own bot, so there is no bot token here.
# Public origin used in alert links; falls back to BETTER_AUTH_URL.
# VEXIS_WEB_URL="http://localhost:3000"
# METEORA_DATAPI_URL="https://dlmm.datapi.meteora.ag"

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the Telegram bot tokens users bring.
# The web app, apps/agents and apps/office need the same value.
TOKEN_ENC_KEY=""
# Same format, each different from the others. LLM_ENC_KEY encrypts users' own LLM keys (web, office); RPC_ENC_KEY
# encrypts users' RPC URLs (web, apps/agents, apps/office). While unset they fall back to TOKEN_ENC_KEY and WALLET_ENC_KEY.
LLM_ENC_KEY=""
RPC_ENC_KEY=""

# Agent wallet secret keys are sealed to a public key, and only apps/agents can open them. Make a pair with
# `bun run db:rewrap --keygen`. WALLET_PUBLIC_KEY goes to the web app (and office); WALLET_PRIVATE_KEY goes to
# apps/agents ONLY, in an environment the web app and office do not share. Never commit either value.
WALLET_PUBLIC_KEY=""
# WALLET_PRIVATE_KEY=""
# Old key for secrets saved before the sealed box. Only apps/agents and `db:rewrap` need it, until the rewrap is done.
# WALLET_ENC_KEY=""

# apps/office (the office's LLM agents). It needs DATABASE_URL, TOKEN_ENC_KEY (bot tokens), LLM_ENC_KEY (users' own LLM
# keys) and RPC_ENC_KEY (agent wallets' RPC URLs). Vexis-paid provider keys, used by offices on the Vexis key source under the daily cap an
# admin sets with `db:office --enable … --vexis-usd N`. A provider without a key here is unavailable on that source.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# META_API_KEY=

# Mail through Resend: invite links from `bun run db:invite --email … --send`, and request notices.
RESEND_API_KEY=""
# MAIL_FROM="Vexis <invite@stunobagent.my.id>"
# Optional: gets a one-line mail for each new invite request from the landing page.
# INVITE_NOTIFY_EMAIL=
