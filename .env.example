# Supabase Postgres via the transaction-mode pooler (port 6543). The app uses prepare: false.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: drizzle-kit only. Session pooler (same host, port 5432). Falls back to DATABASE_URL.
# DATABASE_MIGRATE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Better Auth: a long random string, and the public origin of the web app.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Solana mainnet RPC for on-chain reads in the web app and the runner, and for live auto-rebalance sends.
# Use Helius: live sends take their priority fee from its getPriorityFeeEstimate (another RPC sends with none).
# Without it the public endpoint is used, which rate limits the runner's per-minute position reads.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=<your-helius-key>"

# apps/agents (volume spike and auto-rebalance runner). Telegram alerts go through each user's own bot, so there is no bot token here.
# Public origin used in alert links; falls back to BETTER_AUTH_URL.
# VEXIS_WEB_URL="http://localhost:3000"
# METEORA_DATAPI_URL="https://dlmm.datapi.meteora.ag"

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the Telegram bot tokens users bring.
# The web app and apps/agents need the same value.
TOKEN_ENC_KEY=""

# 32 random bytes, base64, different from TOKEN_ENC_KEY. Encrypts the wallet secret key an auto-rebalance agent manages.
# The web app encrypts with it when a wallet is saved; apps/agents needs the same value (it refuses to start without it)
# to decrypt the wallet for a live rebalance.
WALLET_ENC_KEY=""
