{
  "name": "vexis",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @vexis/web dev",
    "dev:agents": "bun run --filter @vexis/agents dev",
    "start:agents": "bun run --filter @vexis/agents start",
    "dev:worker": "bun run --filter @vexis/worker dev",
    "build": "bun run --filter @vexis/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:fetch": "bun scripts/fetch-docs.ts",
    "db:generate": "bun run --filter @vexis/db generate",
    "db:migrate": "bun run --filter @vexis/db migrate",
    "db:studio": "bun run --filter @vexis/db studio",
    "db:isolation": "bun run --filter @vexis/db isolation",
    "db:invite": "bun packages/db/scripts/invite.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
